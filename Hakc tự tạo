local function Toggle(parent,text,key,fn)
	local b=Button(parent,"")

	local function Update()
		b.Text=text.." ["..(STATE[key] and "ON" or "OFF").."]"
		b.TextColor3=STATE[key]
			and Color3.fromRGB(100,255,150)
			or Color3.fromRGB(235,235,235)
	end

	Update()

	Conn("T"..key,b.Activated,function()
		STATE[key]=not STATE[key]
		Update()
		Safe(fn,STATE[key])
	end)

	return b
end

