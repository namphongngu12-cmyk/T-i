local function StopFly()
	DisconnectGroup("Fly")
	Destroy(FlyVelocity)
	FlyVelocity=nil
	Up.Visible=false
	Down.Visible=false
	FlyUp=false
	FlyDown=false
end

local function StartFly()
	StopFly()

	if not RootPart then return end

	Up.Visible=UIS.TouchEnabled
	Down.Visible=UIS.TouchEnabled

	FlyVelocity=Instance.new("BodyVelocity")
	FlyVelocity.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
	FlyVelocity.Velocity=Vector3.zero
	FlyVelocity.Parent=RootPart

	Conn("FlyLoop",RunService.RenderStepped,function()
		if not STATE.Fly or not RootPart then return end

		local cam=Workspace.CurrentCamera
		if not cam then return end

		local move=Humanoid and Humanoid.MoveDirection or Vector3.zero
		local dir=Vector3.zero

		if move.Magnitude>0 then
			dir=cam.CFrame:VectorToWorldSpace(
				Vector3.new(move.X,0,move.Z)
			).Unit*CONFIG.FlySpeed
		end

		local y=(FlyUp and CONFIG.FlySpeed or 0)
			-(FlyDown and CONFIG.FlySpeed or 0)

		FlyVelocity.Velocity=Vector3.new(dir.X,y,dir.Z)
	end,"Fly")
end

Toggle(Movement,"Fly","Fly",function(v)
	if v then StartFly() else StopFly() end
