local function Safe(f,...)
	return pcall(f,...)
end

local function Conn(n,s,f,g)
	if CON[n] then CON[n]:Disconnect() end
	local c=s:Connect(function(...) Safe(f,...) end)
	CON[n]=c
	if g then
		GROUP[g]=GROUP[g] or {}
		table.insert(GROUP[g],c)
	end
	return c
end

local function Disconnect(n)
	if CON[n] then
		CON[n]:Disconnect()
		CON[n]=nil
	end
end

local function DisconnectGroup(g)
	for _,c in ipairs(GROUP[g] or {}) do
		Safe(function() c:Disconnect() end)
	end
	GROUP[g]=nil
end

local function Destroy(x)
	if x then Safe(function() x:Destroy() end) end
end

