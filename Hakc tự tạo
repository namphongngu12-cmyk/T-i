local function Alive(p)
	local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	return h and h.Health>0
end

local function GetPart(p)
	local c=p.Character
	return c and (c:FindFirstChild(CONFIG.AimPart)
		or c:FindFirstChild("HumanoidRootPart"))
end

local function CanSee(part)
	if not STATE.WallCheck then return true end
	local cam=Workspace.CurrentCamera
	if not cam then return false end

	local rp=RaycastParams.new()
	rp.FilterType=Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances={Character}

	local r=Workspace:Raycast(
		cam.CFrame.Position,
		part.Position-cam.CFrame.Position,
		rp
	)

	return not r or r.Instance:IsDescendantOf(part.Parent)
end

local function Target()
	local cam=Workspace.CurrentCamera
	if not cam or not RootPart then return end

	local center=Vector2.new(
		cam.ViewportSize.X/2,
		cam.ViewportSize.Y/2
	)

	local best,dist=nil,math.huge

	for _,p in ipairs(Players:GetPlayers()) do
		if p~=LP and Alive(p) then
			if not STATE.TeamCheck or p.Team~=LP.Team then
				local part=GetPart(p)

				if part and
					(part.Position-RootPart.Position).Magnitude<=CONFIG.AimDistance then

					local pos,on=cam:WorldToViewportPoint(part.Position)

					if on and pos.Z>0 then
						local d=(Vector2.new(pos.X,pos.Y)-center).Magnitude

						if d<=CONFIG.AimFOV and d<dist and CanSee(part) then
							best=part
							dist=d
						end
					end
				end
			end
		end
	end

	return best
end

Conn("AimLoop",RunService.RenderStepped,function()
	FOV.Visible=STATE.Aim and STATE.FOV
	FOV.Size=UDim2.fromOffset(CONFIG.AimFOV*2,CONFIG.AimFOV*2)

	if STATE.Aim then
		local part=Target()
		local cam=Workspace.CurrentCamera

		if part and cam then
			cam.CFrame=CFrame.lookAt(
				cam.CFrame.Position,
				part.Position
			)
		end
	end
end)

