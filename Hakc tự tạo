local function MakeESP(p)
	if p==LP then return end

	RemoveESP(p)

	local c=p.Character
	local head=c and c:FindFirstChild("Head")
	if not head then return end

	local bill=Instance.new("BillboardGui")
	bill.Size=UDim2.fromOffset(190,65)
